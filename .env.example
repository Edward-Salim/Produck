# Drizzle / Neon Postgres
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Comma-separated emails that may open /financial-tracker in production.
FINANCIAL_TRACKER_ALLOWED_EMAILS="you@example.com"
FINNHUB_API_KEY="your-finnhub-api-key"

# 32 random bytes encoded as base64url. Used to encrypt sensitive DB fields.
DATA_ENCRYPTION_KEY="generate-with-node-crypto-randomBytes-32-base64url"

# Private phone contact for generated Application Kit PDFs.
APPLICATION_EMAIL="you@example.com"
APPLICATION_PHONE_DISPLAY="+6281200000000"
APPLICATION_PHONE_URL="https://wa.me/6281200000000"

# Private local/server-only signature source for Application Kit PDFs.
# Prefer a file outside the repo for local dev.
# For Netlify, use APPLICATION_SIGNATURE_IMAGE_BASE64_CHUNKS and numbered
# APPLICATION_SIGNATURE_IMAGE_BASE64_0, APPLICATION_SIGNATURE_IMAGE_BASE64_1, etc.
APPLICATION_SIGNATURE_PATH="C:\\Users\\you\\.produck-private\\ttd_edward.png"
